# Copy to .env.local for local development; on Vercel, add under
# Settings → Environment Variables. Only secrets and per-environment values
# belong here — brand, contact details and colours live in brand/config.ts,
# payment details and legal texts in the database.
#
# NEXT_PUBLIC_* values are baked in at build time: after changing one on
# Vercel, redeploy.


# --- Supabase (all environments) ---------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SECRET — bypasses RLS. Never NEXT_PUBLIC_, never in a Client Component.
SUPABASE_SERVICE_ROLE_KEY=


# --- Site URL (Production only) ----------------------------------------------
# Leave unset on Preview (falls back to the preview's own URL) and locally
# (falls back to localhost:3000). Production: the `url` in brand/config.ts,
# e.g. https://www.example.ba
NEXT_PUBLIC_SITE_URL=


# --- Email via Resend (Production) -------------------------------------------
# Optional: without the key or sender, mail is skipped and logged, never sent.
RESEND_API_KEY=
# "Brand name <obavijesti@your-domain>" — the domain must be verified in Resend.
EMAIL_FROM="Naziv platforme <obavijesti@example.ba>"
# Contact-form inbox; unset falls back to SITE.contact.email.
CONTACT_EMAIL_TO=info@example.ba


# --- Google sign-in (all environments) ---------------------------------------
# Public. Must match the client id in Supabase → Providers → Google, and each
# origin must be an authorised JavaScript origin in Google Cloud.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=


# --- Cron (Production) -------------------------------------------------------
# SECRET. Long random string; /api/keep-alive refuses requests without it.
CRON_SECRET=


# --- Local only: Supabase CLI and scripts ------------------------------------
SUPABASE_PROJECT_REF=
SUPABASE_DB_PASSWORD=
SUPABASE_ACCESS_TOKEN=
