# =============================================================================
# Environment variables
# =============================================================================
#
# Copy to .env.local for local development. On Vercel, enter them under
# Project → Settings → Environment Variables; each section below says which of
# Vercel's three environments (Production / Preview / Development) needs it.
#
# WHAT BELONGS HERE: values that are secret, or that differ between local,
# preview and production. Nothing else.
#
# WHAT DOES NOT — and where it lives instead:
#   Brand name, contact emails, phone, working hours,
#   social links, company legal details ............ src/lib/siteConfig.ts
#   Payment details (recipient, bank, account) ...... database, /admin/settings/payment
#   Terms of use, privacy policy .................... database, /admin/settings/legal
#
# Those are the same in every environment and public, so as env vars they would
# be untyped, unreviewed, and copied by hand into three places.
#
# NEXT_PUBLIC_* values are inlined at BUILD time: changing one on Vercel needs a
# redeploy, not just a restart.


# -----------------------------------------------------------------------------
# Supabase
# -----------------------------------------------------------------------------
# Vercel: Production, Preview, Development.
# Use a separate Supabase project for production; Preview and Development can
# share the staging one.

# Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co

# Project Settings > API — public, safe in the browser; RLS applies to it.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Project Settings > API — SECRET. Bypasses RLS. Never prefix with NEXT_PUBLIC_,
# never import into a Client Component. Mark it "Sensitive" on Vercel.
SUPABASE_SERVICE_ROLE_KEY=


# -----------------------------------------------------------------------------
# Site URL
# -----------------------------------------------------------------------------
# Vercel: Production ONLY. Leave it unset for Preview: the app then falls back
# to the per-deployment NEXT_PUBLIC_VERCEL_URL that Vercel provides, so links in
# a preview point at that preview. Locally it falls back to localhost:3000.
#
# Used for auth redirects, links in emails, and the certificate's verification
# line. Every origin it can take must also be in Supabase → Authentication →
# URL Configuration → Redirect URLs (for previews:
# https://*-<team>.vercel.app/**).
#
# Never copy the localhost value below into Vercel. It once was, and production
# published localhost as its canonical URL, sitemap and share image. A Vercel
# build now ignores a localhost value (next.config.ts), but the correct
# Production value is https://www.edubox-zepce.ba.
NEXT_PUBLIC_SITE_URL=http://localhost:3000


# -----------------------------------------------------------------------------
# Email (Resend)
# -----------------------------------------------------------------------------
# Vercel: Production. Preview only if you want previews to send real mail.
#
# Optional. With RESEND_API_KEY or EMAIL_FROM missing, every send is skipped and
# logged, never thrown: the contact form falls back to its direct-email link,
# and the notification settings say email is not active. Leaving them unset
# locally is what keeps development from emailing real people.

# https://resend.com → API Keys. SECRET.
RESEND_API_KEY=

# The From: header. Its domain must be verified in Resend (SPF + DKIM records),
# or the provider rejects the send.
EMAIL_FROM="Edubox Žepče <obavijesti@edubox-zepce.ba>"

# Inbox that receives contact-form messages. Unset, they go to the public
# address in siteConfig.ts (SITE.contact.email). Set it per environment so test
# messages from a preview don't land in the real inbox.
CONTACT_EMAIL_TO=info@edubox-zepce.ba


# -----------------------------------------------------------------------------
# Feature flags (staged rollout)
# -----------------------------------------------------------------------------
# Vercel: Production (and Preview, if previews should match it).
#
# ABSENT MEANS ENABLED. Only the literal string "false" turns a feature off, so
# deleting every line below restores the full product. On Vercel that means a
# flag you want OFF must be set to "false" explicitly; leaving it out turns the
# feature on.
#
# A flag hides a feature's navigation and returns 404 for its pages. It is NOT
# access control: the API routes and RLS policies don't read these flags.
NEXT_PUBLIC_FEATURE_CATALOG=true          # public course catalogue + course and module pages
NEXT_PUBLIC_FEATURE_PURCHASES=true        # access requests, admin queue, payment details
NEXT_PUBLIC_FEATURE_QUIZZES=true          # quizzes on a module
NEXT_PUBLIC_FEATURE_TASKS=true            # task submissions + review threads
NEXT_PUBLIC_FEATURE_CERTIFICATES=true     # certificate pages, PDF, delivery
NEXT_PUBLIC_FEATURE_NOTIFICATIONS=true    # in-app bell, list, per-event settings
NEXT_PUBLIC_FEATURE_SUPPORT=true          # /issues and the admin support queue
NEXT_PUBLIC_FEATURE_BLOG=true             # blog index and posts
NEXT_PUBLIC_FEATURE_NEWSLETTER=true       # opt-in, admin composer and export
NEXT_PUBLIC_FEATURE_TEACHERS=true         # teacher role and course ownership UI
NEXT_PUBLIC_FEATURE_THEME_SWITCH=true     # light/dark toggle and its settings tab


# -----------------------------------------------------------------------------
# Google sign-in
# -----------------------------------------------------------------------------
# Vercel: Production (and Preview, if the provider allows preview origins).
#
# The one flag that is OFF unless set to "true": a "Sign in with Google"
# button that fails is worse than no button. The button renders only when the
# flag is "true" AND the client id below is set.
#
# Sign-in runs through Google Identity Services in the browser and hands the
# ID token to Supabase (signInWithIdToken), so Google's popup names this site
# rather than <project-ref>.supabase.co. Requirements:
#   - Google Cloud → OAuth client → Authorized JavaScript origins must list
#     every origin the button runs on (https://www.edubox-zepce.ba,
#     https://edubox-zepce.ba, http://localhost:3000). Preview URLs are not
#     listed, so the button will not render on Vercel previews.
#   - Supabase → Authentication → Providers → Google must be enabled and list
#     the SAME client id, or Supabase rejects the token's audience.
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false

# Google Cloud → APIs & Services → Credentials → OAuth 2.0 Client ID (Web).
# Public — it is sent to the browser by design. Not a secret.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=


# -----------------------------------------------------------------------------
# Local only: Supabase CLI and scripts
# -----------------------------------------------------------------------------
# Vercel: NONE. Read by `npx supabase …` and the scripts in scripts/
# (db:seed, db:verify-rls), which also read the Supabase keys above from
# .env.local.

# Project Settings > General
SUPABASE_PROJECT_REF=

# Database password, for `supabase db push`. SECRET.
SUPABASE_DB_PASSWORD=
