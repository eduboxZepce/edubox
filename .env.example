# Copy to .env.local for local development; on Vercel, add under
# Settings → Environment Variables. Only secrets and per-environment values
# belong here — brand, contact details and copy live in src/lib/siteConfig.ts,
# payment details and legal texts in the database.
#
# NEXT_PUBLIC_* values are baked in at build time: after changing one on
# Vercel, redeploy.


# --- Supabase (all environments) ---------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SECRET — bypasses RLS. Never NEXT_PUBLIC_, never in a Client Component.
SUPABASE_SERVICE_ROLE_KEY=


# --- Site URL (Production only) ----------------------------------------------
# Leave unset on Preview (falls back to the preview's own URL) and locally
# (falls back to localhost:3000). Production: https://www.edubox-zepce.ba
NEXT_PUBLIC_SITE_URL=


# --- Email via Resend (Production) -------------------------------------------
# Optional: without the key or sender, mail is skipped and logged, never sent.
RESEND_API_KEY=
EMAIL_FROM="Edubox Žepče <obavijesti@edubox-zepce.ba>"
# Contact-form inbox; unset falls back to SITE.contact.email.
CONTACT_EMAIL_TO=info@edubox-zepce.ba


# --- Google sign-in (all environments) ---------------------------------------
# Public. Must match the client id in Supabase → Providers → Google, and each
# origin must be an authorised JavaScript origin in Google Cloud.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=


# --- Cron (Production) -------------------------------------------------------
# SECRET. Long random string; /api/keep-alive refuses requests without it.
CRON_SECRET=


# --- Local only: Supabase CLI and scripts ------------------------------------
SUPABASE_PROJECT_REF=
SUPABASE_DB_PASSWORD=
SUPABASE_ACCESS_TOKEN=


# --- Features not launched yet -----------------------------------------------
# A missing flag means the feature is ON; only "false" hides it. To launch a
# feature, delete its line (and redeploy on Vercel). Hides nav and pages only —
# not access control.
NEXT_PUBLIC_FEATURE_CATALOG=false
NEXT_PUBLIC_FEATURE_PURCHASES=false
NEXT_PUBLIC_FEATURE_QUIZZES=false
NEXT_PUBLIC_FEATURE_TASKS=false
NEXT_PUBLIC_FEATURE_CERTIFICATES=false
NEXT_PUBLIC_FEATURE_NOTIFICATIONS=false
NEXT_PUBLIC_FEATURE_SUPPORT=false
NEXT_PUBLIC_FEATURE_BLOG=false
NEXT_PUBLIC_FEATURE_NEWSLETTER=false
NEXT_PUBLIC_FEATURE_TEACHERS=false
NEXT_PUBLIC_FEATURE_THEME_SWITCH=false
